{
  "name": "breathprint",
  "version": "0.1.0",
  "private": true,
  "description": "A smog-season assistant that plans low-exposure, low-emission days for families and communities.",
  "author": "Arjun Krishnan <4rjunkrishnan@gmail.com>",
  "license": "MIT",
  "homepage": "https://breathprint-zeta.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arjunx156/breathprint.git"
  },
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun run server/serve.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "unused": "bun x knip@5.88.1",
    "test": "bun test",
    "coverage": "bun test --coverage && bun run scripts/coverage.ts",
    "eval:replay": "bun run evals/run.ts --replay",
    "check": "bun run lint && bun run typecheck && bun run unused && bun run coverage && bun run build && bun run eval:replay",
    "e2e": "playwright test",
    "eval": "bun run evals/run.ts",
    "record": "bun run evals/record.ts"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@google/genai": "^3.6.0",
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.8",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
