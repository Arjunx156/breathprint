# From https://aistudio.google.com/apikey. Setting it is enough to turn Gemini on. Never commit a real key.
GEMINI_API_KEY=

# gemini, ollama or fake. Empty means gemini when a key is set, and offline otherwise.
LLM_PROVIDER=

# Comma-separated fallback chain, cheapest first. Empty uses the chain in server/llm/config.ts.
LLM_MODELS=

# Only used when LLM_PROVIDER=ollama.
OLLAMA_HOST=http://127.0.0.1:11434

# Milliseconds a single model call may take before the next model or the rule-based plan takes over.
LLM_TIMEOUT_MS=12000

# US dollars per million input and output tokens, for the cost in each log line. 0,0 on the free tier.
LLM_PRICE_PER_MTOK=0,0

# Requests per minute per visitor on the model routes, and on everything else.
RATE_LIMIT_AI_PER_MIN=8
RATE_LIMIT_PER_MIN=60

# Origins allowed to call the API from a browser, comma-separated. Empty means same origin only.
ALLOWED_ORIGINS=

# Bun and Docker only, behind a proxy that overwrites one header with the visitor's address
# (Fly: fly-client-ip, Cloudflare: cf-connecting-ip). Empty means the socket's address.
# Vercel always uses x-real-ip, which its edge writes. x-forwarded-for is refused: clients can forge it.
TRUSTED_IP_HEADER=

PORT=8787

# Public origin for canonical links and the sitemap. Vercel builds fill this in themselves.
SITE_URL=

# Pause between eval and record calls, to stay inside the free tier's requests per minute.
EVAL_DELAY_MS=4000
