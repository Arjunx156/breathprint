{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/evals/recordings", "!**/web/public/fonts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 10 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 50, "skipBlankLines": true }
        },
        "noExcessiveNestedTestSuites": "error",
        "noForEach": "error",
        "noImplicitCoercions": "error",
        "noUselessCatchBinding": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessStringRaw": "error",
        "noUselessUndefined": "error",
        "noUselessUndefinedInitialization": "error"
      },
      "correctness": {
        "noNestedComponentDefinitions": "error",
        "noReactPropAssignments": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noBarrelFile": "error",
        "noDelete": "error",
        "noNamespaceImport": "error",
        "noReExportAll": "error",
        "useTopLevelRegex": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noEnum": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noProcessEnv": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": "error",
        "useConsistentArrowReturn": "error",
        "useConsistentCurlyBraces": "error",
        "useConsistentTypeDefinitions": { "level": "error", "options": { "style": "type" } },
        "useConst": "error",
        "useErrorCause": "error",
        "useExplicitLengthCheck": "error",
        "useExportType": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["camelCase", "kebab-case", "PascalCase"] }
        },
        "useForOf": "error",
        "useGroupedAccessorPairs": "error",
        "useImportType": "error",
        "useNumericSeparators": "error",
        "useReadonlyClassProperties": "error",
        "useShorthandAssign": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useUnifiedTypeSignatures": "error"
      },
      "suspicious": {
        "noConsole": { "level": "error", "options": { "allow": ["error", "warn", "info"] } },
        "noDeprecatedImports": "error",
        "noEmptyBlockStatements": "error",
        "noEvolvingTypes": "error",
        "noExplicitAny": "error",
        "noImportCycles": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noShadow": "error",
        "noUnusedExpressions": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["shared/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**", "**/web/**", "@server/**", "@web/**"],
                    "message": "The engine is shared by both sides, so it imports neither."
                  },
                  {
                    "group": ["react", "react-dom", "hono", "hono/**", "@google/genai"],
                    "message": "The engine is pure: no UI, no HTTP and no model calls."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["web/src/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": { "rules": { "correctness": { "noNodejsModules": "error" } } }
    },
    {
      "includes": ["server/env.ts", "scripts/**", "evals/**", "*.config.ts"],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.e2e.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": { "maxLines": 80, "skipBlankLines": true }
            }
          },
          "performance": { "useTopLevelRegex": "off" }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
